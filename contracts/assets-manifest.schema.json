{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-figure-skill.dev/schemas/assets-manifest.schema.json",
  "title": "Paper Figure Skill asset manifest",
  "type": "object",
  "required": ["schema_version", "inventory", "jobs"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "inventory": {
      "type": "object",
      "required": ["granularity", "semantic_pass_complete", "residual_pass_complete", "unexplained_visuals"],
      "properties": {
        "granularity": { "const": "fine-grained" },
        "semantic_pass_complete": { "const": true },
        "residual_pass_complete": { "const": true },
        "unexplained_visuals": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": true
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "strategy", "vector_kind", "asset_role", "bbox", "source_element_ids", "source", "editable_level"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "strategy": { "enum": ["native-text", "native-shape", "direct-extract", "regenerate-grounded"] },
          "vector_kind": { "enum": ["native-vector", "embedded-raster"] },
          "asset_role": { "enum": ["icon", "ui-component", "illustration", "decoration", "native-component"] },
          "background_requirement": { "enum": ["transparent", "preserve-source"] },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "source_element_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "type": "string", "minLength": 1 } },
            "additionalProperties": true
          },
          "editable_level": { "enum": ["full", "geometry-and-style", "position-and-scale", "none"] },
          "status": { "enum": ["pending", "completed", "blocked"] },
          "prompt": { "type": ["string", "null"] },
          "output_svg": { "type": "string" },
          "output_png": { "type": "string" },
          "alpha": {
            "type": "object",
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "transparent_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "visible_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
